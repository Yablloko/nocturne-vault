{
  "name": "nocturne-vault",
  "version": "0.8.14",
  "description": "Полностью локальное зашифрованное хранилище для Windows",
  "author": "Nocturne",
  "license": "GPL-3.0-only",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Yablloko/nocturne-vault.git"
  },
  "bugs": {
    "url": "https://github.com/Yablloko/nocturne-vault/issues"
  },
  "homepage": "https://github.com/Yablloko/nocturne-vault#readme",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.19.0",
  "main": "src/main.js",
  "type": "commonjs",
  "scripts": {
    "build:quick": "esbuild src/quick/quick.jsx --bundle --outfile=src/quick/quick.bundle.js --format=iife --platform=browser --minify",
    "start": "pnpm build:quick && electron .",
    "dist:win": "pnpm build:quick && electron-builder --win nsis",
    "test": "node --test tests/*.test.js",
    "check": "pnpm build:quick && node --check src/main.js && node --check src/preload.js && node --check src/quick/preload.js && node --check src/services/vault-service.js && node --check src/services/activity-service.js && node --check src/services/media-range.js && node --check src/services/legacy-temp-cleanup.js && node --check src/services/otp-service.js && node --check src/services/app-preferences-service.js && node --check src/services/windows-autostart-service.js && node --check src/renderer/app.js"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "jsqr": "1.4.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "electron": "43.4.1",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.9",
    "playwright": "1.62.1"
  },
  "build": {
    "appId": "com.nocturne.vault",
    "productName": "Nocturne Vault",
    "artifactName": "Nocturne-Vault-Setup-${version}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "LICENSE",
      "package.json"
    ],
    "win": {
      "icon": "assets/nocturne.ico",
      "target": "nsis"
    },
    "nsis": {
      "include": "build/installer.nsh",
      "license": "LICENSE",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
